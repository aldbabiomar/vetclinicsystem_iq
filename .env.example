# Copy this file to .env — setup.py does this for you automatically and
# fills in a random SECRET_KEY. You normally don't need to edit this by hand.

DATABASE_URL=postgresql://vetclinicsystemiq:vetclinicsystemiq_local_password@127.0.0.1:5432/vetclinicsystemiq
POSTGRES_PASSWORD=vetclinicsystemiq_local_password
SECRET_KEY=change-me

# Which Postgres container to run pg_dump against for nightly backups
# (matches docker-compose.yml's container_name). Only used if a local
# pg_dump binary isn't found on this machine.
VETCLINICSYSTEMIQ_PG_CONTAINER=vetclinicsystemiq_postgres

# --- In-app updates (Settings -> Updates) ---
# The GitHub repo this app checks for tagged Releases. Never a literal
# string anywhere in code — see updater.py and
# CLAUDE_CODE_RELEASE_WORKFLOW.md.
GITHUB_REPO=aldbabiomar/vetclinicsystem_iq
# Only needed if the repo above is private — a GitHub personal access
# token with read-only "Contents" access, used to download release
# tarballs. Leave unset for a public repo.
#GITHUB_TOKEN=
# Only set these two once you've run `python3 setup.py --enable-updates`
# to switch this install onto the versioned-release layout (see
# UPDATE_MECHANISM_PLAN.md §3) — updates are disabled until both point at
# real folders outside this codebase.
#VETCLINICSYSTEMIQ_DATA_DIR=
#VETCLINICSYSTEMIQ_RELEASES_DIR=

# --- Optional network/session hardening (all opt-in; app behaves exactly
# as before if you leave these unset) ---
# Set to 1 only if a reverse proxy (nginx/Caddy/etc) is terminating TLS in
# front of this app. Waitress itself never terminates TLS.
#BEHIND_TLS_PROXY=1
# How long a login session stays valid even if the browser is never
# closed. Defaults to 12 hours.
#SESSION_LIFETIME_HOURS=12
# Restrict which client IPs may reach the app at all, as a comma-separated
# list of CIDR blocks. Leave unset on a normal single-router clinic LAN.
#VETCLINICSYSTEMIQ_ALLOWED_NETWORKS=192.168.1.0/24
# Override the default bind address/port (0.0.0.0:5050).
#VETCLINICSYSTEMIQ_HOST=0.0.0.0
#VETCLINICSYSTEMIQ_PORT=5050

# --- Optional connection pool sizing (defaults are fine for a
# single-clinic deployment; see db.py) ---
#DB_POOL_MIN_SIZE=2
#DB_POOL_MAX_SIZE=15
#DB_POOL_TIMEOUT_SECONDS=10
#DB_POOL_MAX_LIFETIME_SECONDS=1800
